# 로컬 개발용 환경 변수 예시
# 이 파일을 복사해서 .env.local을 만들고 실제 Supabase 값을 입력하세요.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 서버에서 notifications 생성 후 FCM HTTP v1 푸시를 발송할 때 사용합니다.
# Vercel Project Settings > Environment Variables에 실제 값을 등록하세요.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# Supabase Auth > URL Configuration > Redirect URLs에 아래 주소를 추가하세요.
# http://localhost:3000/auth/callback
